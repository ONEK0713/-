{
  "name": "local-music-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import=./tools/net-exec-shim.mjs ./node_modules/vite/bin/vite.js --port 8787 --strictPort",
    "build": "tsc --noEmit && node --import=./tools/net-exec-shim.mjs ./node_modules/vite/bin/vite.js build",
    "build:single": "tsc --noEmit && node --import=./tools/net-exec-shim.mjs tools/build-single.mjs",
    "preview": "node --import=./tools/net-exec-shim.mjs ./node_modules/vite/bin/vite.js preview --port 8787 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --import=./tools/net-exec-shim.mjs ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "music-metadata": "^12.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@typescript/typescript-win32-x64": "7.0.2"
  }
}
