{
  "name": "local-music-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "set \"NODE_OPTIONS=--import=./tools/net-exec-shim.mjs\" && vite --port 8787 --strictPort",
    "build": "tsc --noEmit && set \"NODE_OPTIONS=--import=./tools/net-exec-shim.mjs\" && vite build",
    "preview": "set \"NODE_OPTIONS=--import=./tools/net-exec-shim.mjs\" && vite preview --port 8787 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "set \"NODE_OPTIONS=--import=./tools/net-exec-shim.mjs\" && vitest run"
  },
  "dependencies": {
    "music-metadata": "^12.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript-win32-x64": "7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
